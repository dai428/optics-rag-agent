# D:\Desktop\rag-demo\.env.example
# 复制本文件为 .env 后填入真实值。
# ⚠️ 本文件是「可以提交到 Git 的模板」，只放键名与示例值，绝不放真实密钥。

# AMD Radeon Cloud API 配置
AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# 生成模型（2026-10-08 实测单次调用耗时）：
#   DeepSeek-V4-Flash      2.2s  ← 推荐：开发调试默认
#   Qwen3.8-Flash-Next     2.1s
#   MiMo-V2.6-Flash        2.5s
#   DeepSeek-V4.1-Flash   >90s  ← 慢，易超时
#   Qwen3.8-27B          60~360s ← 推理模型，质量最好但极慢，适合出正式报告
AMD_LLM_MODEL=DeepSeek-V4-Flash

# 本地 Embedding（免费，无需 Key）
LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 可选：查询改写专用的小模型（留空 = 与 AMD_LLM_MODEL 相同）
# 改写任务只是「把省略句补全成完整问句」，用大模型又慢又没必要。
# 若 AMD 平台提供更快的模型（如 Qwen3.8-Flash-Next），填在这里可显著提速。
AMD_REWRITE_MODEL=

# 重排开关：1 = 开启（推荐，Recall@5 从 85% 提到 100%）；0 = 关闭（省 ~0.5s/次）
USE_RERANK=1
# 重排模型（默认 BAAI/bge-reranker-base，约 1.1GB，首次运行会自动下载）
# RERANK_MODEL=BAAI/bge-reranker-base
