data/models/
# 环境与缓存
.venv/
.piptmp/
__pycache__/
*.pyc
.idea/

# ── 公开示例语料的派生产物 ────────────────────────────
# 说明：data/sample_docs/ 与 data/sample_eval_set.json 是**脱敏教学示例**，
# 需要提交，供面试官 clone 后一键复现。但它们跑出来的索引属于派生产物，
# 体积大且可重建，因此单独忽略（与私有语料同理）。
data/sample_chroma_db/
data/sample_parent_store/
data/sample_index_manifest.json

# ── 索引清单与运行期数据 ──────────────────────────────
# 清单记录了本机语料指纹，换机器即失效，不应入库
data/index_manifest.json
# SQLite 会话/反馈/日志数据库
data/app.db
data/app.db-wal
data/app.db-shm

# 运行期产物（本地临时文件，不入库）
*.log
snap_probe.txt
eval_report*.json
sample_eval_report.json
htmlcov/
.pytest_cache/
# 消融探针的输出（每次跑都会变，属于运行期产物；
# 探针脚本本身在 scripts/ 里，是入库的）
data/probe_ablation.json
data/probe_source_prior.json

# 生成层评测中间产物：eval_gen_raw.json 含语料原文，绝不能提交
data/eval_gen_raw.json
data/eval_gen_report.json

# 参考资料：第三方开源仓库克隆（体积大，且各自有 git 历史，不入库）
refs/
# legacy 目录下的运行日志
legacy/run_log*.txt

# ── 私有语料与评测集（绝不提交）──────────────────────
# data/eval_set.json 记录了未发表论文的实验数值与期望来源，
# 仅用于本地私有语料的检索评测；公开仓库使用 data/sample_eval_set.json。
data/eval_set.json

# ── 个人学习笔记与面试准备材料（不随仓库发布）────────
# notes/ 是基于私有语料的评测报告与面试八股，属于个人资料而非项目交付物。
# 其中 notes/评测报告.html 引用了未发表论文的文档名与题目内容。
notes/

